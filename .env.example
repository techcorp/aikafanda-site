# ---- Blogger (required for /blog) -------------------------------------------
# 1. console.cloud.google.com -> new project -> enable "Blogger API v3"
# 2. Credentials -> Create credentials -> API key  (restrict it to Blogger API)
BLOGGER_API_KEY=your_google_api_key
# Blogger dashboard -> open your blog -> the number in the URL after blogID=
BLOGGER_BLOG_ID=1234567890123456789

# ---- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.aikafanda.com

# ---- Contact form (optional) ------------------------------------------------
# Without this the form still works and just logs to the Vercel function log.
RESEND_API_KEY=
CONTACT_TO_EMAIL=support@aikafanda.com
CONTACT_FROM_EMAIL=support@aikafanda.com

# ---- On-demand blog refresh (optional) --------------------------------------
# Hit /api/revalidate?secret=... after publishing a post to refresh instantly.
REVALIDATE_SECRET=change_this_to_a_random_string
